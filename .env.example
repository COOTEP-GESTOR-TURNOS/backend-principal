# Copie como .env para desarrollo local (npm run start:dev). En Docker las variables
# vienen de infra/compose.apps.yml del repositorio cootep-turno.
PORT=3000
DATABASE_URL=postgres://cootep:cambiar_postgres@localhost:5432/cootep
REDIS_URL=redis://:cambiar_redis@localhost:6379/0
MONGO_URL=mongodb://cootep_app:cambiar_mongo_app@localhost:27017/cootep?authSource=cootep
MONGO_DB=cootep
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_DATACENTER=datacenter1
MOTOR_FILAS_URL=http://localhost:8081
ANALITICA_URL=http://localhost:8000
SERVICE_TOKEN=cambiar_token_entre_servicios
JWT_SECRETO=cambiar_este_secreto_de_32_caracteres_o_mas
CORS_ORIGENES=http://localhost:5173
SUPERADMIN_EMAIL=superadmin@cootep-turno.test
SUPERADMIN_PASSWORD_TEMPORAL=
